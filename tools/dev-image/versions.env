# Versions of the development image. Each line is NAME=value, read by
# run.sh as build arguments and by check-versions.sh, which compares the
# values with the pins of the workflows.

# Ubuntu 24.04, the release of the ubuntu-24.04 runner, by multi-platform index digest.
UBUNTU_IMAGE=ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
# Its packages, the compiler and download tools, come from the archive at build time.

# Temurin 21, the major release that actions/setup-java installs in the workflows.
TEMURIN_VERSION=21.0.13+9
TEMURIN_SHA256_AMD64=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c
TEMURIN_SHA256_ARM64=e3522e707fc7dbe2a72c30746b1e7068301a0213ecd213d4491f35a14eb55578

MAVEN_VERSION=3.9.16
MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6

RUSTUP_VERSION=1.29.2
RUSTUP_SHA256_AMD64=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
RUSTUP_SHA256_ARM64=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
# The workflows install the current stable release; check-versions.sh reports when it differs.
RUST_STABLE=1.99.1
# The rust-version of Cargo.toml.
RUST_MSRV=1.88
RUST_NIGHTLY=nightly-2026-10-25

# OpenSSL releases, as recorded in fixtures-openssl.yml.
OPENSSL_MANIFEST_VERSION=3.5.9
OPENSSL_MANIFEST_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
OPENSSL_OTHER_VERSION=4.0.3
OPENSSL_OTHER_SHA256=325b5c806167c13b40b1ffeadfe0248197c00eccc4cf123ec1e28d2d2fd216d9

# yq 4, for .github/scripts/check-dependabot-lists.sh.
YQ_VERSION=4.54.1
YQ_SHA256_AMD64=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
